<Window x:Class="DiskCleanerAssistant.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="磁盘清理助手"
        Width="1320"
        Height="820"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="20,26,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="D" FontSize="21" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="磁盘清理助手" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <TextBlock Text="看清空间，放心清理" Foreground="#94A0B8" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Background="#27334B" CornerRadius="8" Padding="12,11" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="◫" Foreground="#9DB0FF" FontSize="18" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="空间分析" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Padding="12,11" Margin="0,0,0,4" Opacity="0.48">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="◇" Foreground="White" FontSize="17" />
                            <TextBlock Grid.Column="1" Text="垃圾清理（规划中）" Foreground="White" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Padding="12,11" Opacity="0.48">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="◎" Foreground="White" FontSize="17" />
                            <TextBlock Grid.Column="1" Text="重复文件（规划中）" Foreground="White" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Row="4" Background="#202C42" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="安全清理" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="删除操作会移入 Windows 回收站，可以恢复。" Foreground="#9BA8BF" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="17" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="26,20,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="150" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="空间占用分析" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="查看磁盘空间去向，筛选大文件后手动清理" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="刷新磁盘" Command="{Binding RefreshDrivesCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="本机磁盘" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="4,0,0,8" />
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="250" Margin="3,2,10,4"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.SelectDriveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Border BorderBrush="#E2E6EE" BorderThickness="1" CornerRadius="9" Padding="13,10" Background="#FAFBFD">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Format}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="8,0,0,0" />
                                                </Grid>
                                                <ProgressBar Grid.Row="1" Height="6" Minimum="0" Maximum="100" Value="{Binding UsagePercent, Mode=OneWay}" Margin="0,11,0,6" Foreground="{StaticResource PrimaryBrush}" Background="#E9ECF3" BorderThickness="0" />
                                                <TextBlock Grid.Row="2" Text="{Binding CapacityText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                                <TextBlock Grid.Row="3" Text="{Binding FreeText}" Foreground="#4A61D7" FontSize="10" Margin="0,3,0,0" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="18,15,18,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入磁盘或文件夹路径" />
                        <Button Grid.Column="1" Content="选择文件夹" Command="{Binding BrowseCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding SelectedSizeOption}" />
                        <Button Grid.Column="5" Content="开始扫描" Command="{Binding StartScanCommand}" Style="{StaticResource PrimaryButton}" MinWidth="96" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="已扫描 " Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ScannedFileCountText}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="占用 " Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ScannedBytesText}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <TextBlock Text="耗时 " Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ElapsedText}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                        <TextBlock Grid.Column="6" Text="{Binding SkippedCountText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" Foreground="#526079" FontSize="11" VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                            <Button Content="停止" Command="{Binding CancelScanCommand}" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="10,0,0,0"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34*" MinWidth="270" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="66*" MinWidth="500" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#E7EAF0" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="目录占用" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Grid.Column="1" Text="一级目录" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                </Grid>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FolderUsages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4,2,8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding FileCount, StringFormat={}{0:N0} 个文件}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{StaticResource TextBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                                                        <Button Grid.Column="2" Content="打开" Padding="6,3" FontSize="9" Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                    <ProgressBar Grid.Row="1" Height="4" Minimum="0" Maximum="100" Value="{Binding PercentOfTotal, Mode=OneWay}" Margin="0,5,0,0" Foreground="#8295F8" Background="#ECEFF5" BorderThickness="0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" BorderBrush="#E7EAF0" BorderThickness="1" CornerRadius="8" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="大文件" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding FileTypes}" SelectedItem="{Binding SelectedFileType}" Padding="7,4" />
                                    <TextBox Grid.Column="3" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="7,4" ToolTip="按文件名或路径搜索" />
                                </Grid>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredFiles}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          BorderThickness="0" RowHeaderWidth="0" SelectionMode="Single"
                                          Background="White" AlternatingRowBackground="#FAFBFD"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                          HorizontalGridLinesBrush="#EEF0F4" VerticalGridLinesBrush="Transparent">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F5F7FA" />
                                            <Setter Property="Foreground" Value="#606A7C" />
                                            <Setter Property="FontSize" Value="10" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Padding" Value="8,7" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Setter Property="BorderBrush" Value="#E7EAF0" />
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="5,3" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="FontSize" Value="10" />
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Width="34" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTemplateColumn Header="文件" Width="2*" MinWidth="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding DirectoryPath}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="类型" Width="62" Binding="{Binding Category}" IsReadOnly="True" />
                                        <DataGridTextColumn Header="大小" Width="76" Binding="{Binding SizeText}" IsReadOnly="True" />
                                        <DataGridTextColumn Header="修改时间" Width="112" Binding="{Binding LastModifiedText}" IsReadOnly="True" />
                                        <DataGridTemplateColumn Header="位置" Width="55">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="查看" Padding="6,3" FontSize="9" Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="全选当前结果" Command="{Binding SelectAllVisibleCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6" />
                        <Button Grid.Column="1" Content="取消选择" Command="{Binding ClearSelectionCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="8,0,0,0" />
                        <TextBlock Grid.Column="3" Text="{Binding SelectedSummaryText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="11" />
                        <Button Grid.Column="5" Content="移入回收站" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource PrimaryButton}" Padding="16,7" />
                    </Grid>

                    <ProgressBar Grid.RowSpan="7" Height="3" VerticalAlignment="Top" IsIndeterminate="True" Foreground="{StaticResource PrimaryBrush}" BorderThickness="0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
