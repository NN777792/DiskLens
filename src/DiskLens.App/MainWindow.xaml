<Window x:Class="DiskLens.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:DiskLens.App.Controls"
  Title="清简 · 磁盘助手" Width="1360" Height="920" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#192339"><Grid Margin="18,28,18,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="10,0,0,34">
        <StackPanel Orientation="Horizontal"><Border Width="33" Height="33" Background="#5979E8" CornerRadius="9"><TextBlock Text="◫" Foreground="White" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="清简" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="12,0,0,0"/></StackPanel>
        <TextBlock Text="D I S K L E N S" Foreground="#8493AE" FontSize="10" Margin="46,7,0,0"/>
      </StackPanel>
      <StackPanel Grid.Row="1">
        <TextBlock Text="工作空间" Foreground="#697B9A" FontSize="11" Margin="17,0,0,14"/>
        <Button Style="{StaticResource NavButton}" Click="OverviewClick" Background="#2A3C64" Foreground="#F3F6FF"><TextBlock Text="◫   磁盘概览" Width="130"/></Button>
        <Button Style="{StaticResource NavButton}" Click="AnalysisClick"><TextBlock Text="▥   空间分析" Width="130"/></Button>
        <Button Style="{StaticResource NavButton}" Click="CleanupClick"><TextBlock Text="◇   安全清理" Width="130"/></Button>
        <Button Style="{StaticResource NavButton}" Click="HistoryClick"><TextBlock Text="◷   操作记录" Width="130"/></Button>
        <Border Height="1" Background="#2A354C" Margin="16,26,16,22"/>
        <Button Style="{StaticResource NavButton}" Click="ProtectionClick"><TextBlock Text="⌑   保护规则" Width="130"/></Button>
      </StackPanel>
      <Border Grid.Row="2" Background="#202E47" CornerRadius="10" Padding="15"><StackPanel>
        <TextBlock Text="文件留在你的电脑" Foreground="#DBE4F5" FontSize="12"/>
        <TextBlock Text="本地扫描 · 无需登录" Foreground="#91A1BD" FontSize="11" Margin="0,6,0,0"/>
        <TextBlock Text="预览版 0.1.0" Foreground="#697B9A" FontSize="10" Margin="0,15,0,0"/>
      </StackPanel></Border>
    </Grid></Border>
    <Grid Grid.Column="1" Margin="30,25,30,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,21">
        <StackPanel><TextBlock Text="让每一份空间，都清清楚楚。" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="看懂磁盘占用，再决定如何整理。" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="刷新磁盘" Click="RefreshClick" IsEnabled="{Binding IsIdle}" Margin="0,0,10,0"/>
          <Button Content="＋  选择文件夹" Style="{StaticResource PrimaryButton}" Click="FolderClick" IsEnabled="{Binding IsIdle}"/>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
      <ItemsControl ItemsSource="{Binding Drives}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
          <Border Style="{StaticResource Card}" Width="286" Margin="0,0,12,10" Padding="19,16">
            <StackPanel>
              <DockPanel><TextBlock Text="▣" Foreground="#5979E8" FontSize="22" Margin="0,0,10,0"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Kind}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></DockPanel>
              <ProgressBar Value="{Binding Percent}" Foreground="{Binding BarBrush}" Margin="0,18,0,10"/>
              <DockPanel><TextBlock Style="{StaticResource MutedText}"><Run Text="可用 "/><Run Text="{Binding FreeText}" Foreground="#27344D"/></TextBlock><TextBlock Text="{Binding TotalText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></DockPanel>
              <Button Content="扫描此磁盘  →" Tag="{Binding Root}" Click="DriveClick" Padding="10,7" Margin="0,14,0,0" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
        <UniformGrid Columns="3">
          <StackPanel Margin="22,16"><TextBlock Text="已扫描文件大小" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding ScanSize}" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,3"/><TextBlock Text="{Binding ScanCount}" Style="{StaticResource MutedText}"/></StackPanel>
          <StackPanel Margin="22,16"><TextBlock Text="临时文件建议" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding CandidateSize}" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,3" Foreground="#4D9A91"/><TextBlock Text="查看后选择 · 默认不勾选" Style="{StaticResource MutedText}"/></StackPanel>
          <StackPanel Margin="22,16"><TextBlock Text="扫描耗时" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Duration}" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,3"/><TextBlock Text="只读扫描 · 支持随时取消" Style="{StaticResource MutedText}"/></StackPanel>
        </UniformGrid>
      </Border>
      <Border Grid.Row="3" Background="#EDF2FE" CornerRadius="7" Padding="13,10" Margin="0,0,0,13"><TextBlock Text="{Binding Notice}" Foreground="#53658D" FontSize="11"/></Border>
      <TabControl x:Name="MainTabs" Grid.Row="4" SelectedIndex="0">
        <TabItem Header="空间分析">
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="245"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="1.1*" MinHeight="90"/><RowDefinition Height="*" MinHeight="60"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,14,12"><Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,12"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="⌂" ToolTip="返回扫描根目录" Padding="8,3" Command="{Binding RootCommand}" Margin="6,0,0,0"/><Button Content="↑ 上一级" Padding="9,3" Margin="6,0,0,0" Command="{Binding UpCommand}"/></StackPanel><StackPanel><TextBlock Text="空间分布" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding CurrentPath}" ToolTip="{Binding CurrentPath}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></DockPanel>
              <controls:SpaceMap x:Name="Map" Grid.Row="1" Node="{Binding CurrentNode}" MinHeight="80" IsEnabled="{Binding IsIdle}"/>
            </Grid></Border>
            <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource Card}" Padding="18,16"><DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18"><TextBlock Text="文件类型" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="整个扫描范围的分布" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Categories}"><ItemsControl.ItemTemplate><DataTemplate>
                <StackPanel Margin="0,0,0,20"><DockPanel><TextBlock Text="●" Foreground="{Binding Color}" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" FontSize="12"/><TextBlock Text="{Binding Size}" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="12"/></DockPanel><ProgressBar Value="{Binding Percent}" Foreground="{Binding Color}" Height="4" Margin="0,8,0,5"/><TextBlock Text="{Binding Count}" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            </DockPanel></Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Margin="18,12"><TextBlock Text="目录排行" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="双击进入目录" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></DockPanel>
              <DataGrid x:Name="DirectoryGrid" Grid.Row="1" ItemsSource="{Binding Directories}" IsReadOnly="True" MouseDoubleClick="DirectoryDoubleClick"><DataGrid.Columns>
                <DataGridTextColumn Header="文件夹" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="大小" Binding="{Binding Size}" SortMemberPath="Bytes" Width="110"/><DataGridTextColumn Header="占比" Binding="{Binding Share}" SortMemberPath="Percent" Width="80"/>
              </DataGrid.Columns></DataGrid>
            </Grid></Border>
          </Grid>
        </TabItem>
        <TabItem Header="大文件">
          <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="按文件名或完整路径搜索" Margin="0,0,12,0"/><ComboBox Grid.Column="1" SelectedIndex="{Binding SizeFilter}" Margin="0,0,12,0"><ComboBoxItem Content="全部大小"/><ComboBoxItem Content="大于等于 100 MB"/><ComboBoxItem Content="大于等于 1 GB"/><ComboBoxItem Content="大于等于 10 GB"/></ComboBox><Button Grid.Column="2" Content="打开所在位置" Click="OpenFileLocationClick" Tag="large" IsEnabled="{Binding IsIdle}"/></Grid>
            <TextBlock Grid.Row="1" Text="{Binding FileListCaption}" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
            <DataGrid x:Name="LargeFilesGrid" Grid.Row="2" ItemsSource="{Binding FilteredFiles}" IsEnabled="{Binding IsIdle}"><DataGrid.Columns>
              <DataGridTemplateColumn Header="选择" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" ToolTip="{Binding Reason}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="文件名" Binding="{Binding Name}" IsReadOnly="True" Width="1.3*"/><DataGridTextColumn Header="大小" Binding="{Binding Size}" SortMemberPath="Bytes" IsReadOnly="True" Width="100"/><DataGridTextColumn Header="修改时间" Binding="{Binding Modified}" IsReadOnly="True" Width="150"/><DataGridTextColumn Header="完整路径" Binding="{Binding Path}" IsReadOnly="True" Width="2*"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" IsReadOnly="True" Width="90"/>
            </DataGrid.Columns></DataGrid>
          </Grid></Border>
        </TabItem>
        <TabItem Header="安全清理">
          <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14"><TextBlock Text="先确认，再清理。" FontWeight="SemiBold" FontSize="18"/><TextBlock Text="仅推荐当前用户临时目录中至少 7 天未修改的文件。关闭相关软件后操作；个人文件可在“大文件”页面选择。" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding TempCaption}" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
            <DataGrid Grid.Row="2" ItemsSource="{Binding TempFiles}" IsEnabled="{Binding IsIdle}"><DataGrid.Columns>
              <DataGridTemplateColumn Header="选择" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="文件名" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="大小" Binding="{Binding Size}" SortMemberPath="Bytes" IsReadOnly="True" Width="100"/><DataGridTextColumn Header="修改时间" Binding="{Binding Modified}" IsReadOnly="True" Width="150"/><DataGridTextColumn Header="路径" Binding="{Binding Path}" IsReadOnly="True" Width="2*"/>
            </DataGrid.Columns></DataGrid>
          </Grid></Border>
        </TabItem>
        <TabItem Header="操作记录">
          <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14"><Button Content="打开记录文件夹" Click="HistoryFolderClick" DockPanel.Dock="Right"/><StackPanel><TextBlock Text="每一次操作，都有记录。" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="移入回收站后，可通过 Windows 回收站的“还原”恢复；未完成项目需核实实际文件状态。" Style="{StaticResource MutedText}" Margin="0,8,15,0"/></StackPanel></DockPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding History}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Date}" Width="*"/><DataGridTextColumn Header="已移入回收站" Binding="{Binding Success}" Width="130"/><DataGridTextColumn Header="失败或跳过" Binding="{Binding Failed}" Width="110"/><DataGridTextColumn Header="未记录结果" Binding="{Binding Unfinished}" Width="110"/><DataGridTextColumn Header="文件大小" Binding="{Binding Size}" Width="160"/></DataGrid.Columns></DataGrid>
          </Grid></Border>
        </TabItem>
      </TabControl>
      <Border Grid.Row="5" Margin="0,16,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}"><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,15,0"><StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="#5EA99E" Margin="0,0,8,0"/><TextBlock Text="{Binding Status}" FontSize="12"/><Button Content="扫描详情" Click="ScanDetailsClick" Padding="8,1" Margin="12,0,0,0" FontSize="11"/></StackPanel><ProgressBar IsIndeterminate="True" Visibility="{Binding IsScanning, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0" Height="3"/><TextBlock Text="{Binding ScanPath}" ToolTip="{Binding ScanPath}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource MutedText}" FontSize="10" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="取消扫描" Click="CancelClick" Visibility="{Binding IsScanning, Converter={StaticResource BoolVisibility}}" Margin="0,0,12,0"/><TextBlock Text="{Binding SelectedText}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/><Button Content="取消选择" Command="{Binding ClearSelectionCommand}" Margin="0,0,10,0"/><Button Content="查看清理清单  →" Style="{StaticResource PrimaryButton}" Click="ReviewClick" IsEnabled="{Binding HasSelected}"/></StackPanel>
      </Grid></Border>
    </Grid>
  </Grid>
</Window>
