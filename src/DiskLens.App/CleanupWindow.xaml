<Window x:Class="DiskLens.App.CleanupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="确认清理清单" Width="870" Height="640" MinWidth="720" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="这些文件，将被移入回收站。" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="Summary" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel>
    <Border Grid.Row="1" Background="#FFF3E5" CornerRadius="8" Padding="14" Margin="0,18,0,16"><TextBlock Text="请先关闭相关软件，核实个人文件用途。回收站仍占用磁盘空间，可通过 Windows 回收站还原。暂不支持可移动磁盘或网络磁盘的清理。" Foreground="#90672E"/></Border>
    <DataGrid Grid.Row="2" x:Name="ReviewGrid" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="完整路径" Binding="{Binding File.FullPath}" Width="2*"/><DataGridTextColumn Header="大小" Binding="{Binding File.SizeText}" Width="90"/><DataGridTextColumn Header="清理理由与影响" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
    <CheckBox x:Name="Acknowledged" Grid.Row="3" Margin="0,18,0,18" Content="我已核对清单，确认这些文件当前不需要使用。"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="返回检查" IsCancel="True" Margin="0,0,12,0"/><Button Content="确认移入回收站" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsChecked, ElementName=Acknowledged}" Click="ConfirmClick"/></StackPanel>
  </Grid>
</Window>
